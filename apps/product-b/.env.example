NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared staff login (one username/password pair, gates the whole app via middleware.ts).
# Not per-staff-member accounts -- see root CLAUDE.md / DECISIONS.md for why.
STAFF_USERNAME=
STAFF_PASSWORD=
# A long random value used as the session cookie itself -- generate your own, e.g.:
#   openssl rand -hex 32
STAFF_SESSION_SECRET=
