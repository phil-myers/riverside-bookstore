NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (no NEXT_PUBLIC_ prefix — never sent to the browser). Enables live cover
# images from the Google Books API on the sample-data catalog path. Optional: catalog works
# without it, just without cover art.
GOOGLE_BOOKS_API_KEY=

# Optional. Where the homepage's quiet "Staff" footer links point -- Product B (inventory/ops)
# and Product D (content generator). Not secrets, just page addresses; safe as NEXT_PUBLIC_.
# Neither product is deployed yet (see docs/DEPLOYMENT.md), so both default to local dev ports
# (3001, 3002) if left blank. No real access control exists behind these links yet -- see
# DECISIONS.md / TEAM_PLAN.md for the planned basic staff login before this site is published.
NEXT_PUBLIC_PRODUCT_B_URL=
NEXT_PUBLIC_PRODUCT_D_URL=

# Optional. Where the top nav's "Chat" link points -- Product C (support chatbot). Same
# reasoning as the Staff links above: not a secret, defaults to local dev port (3003) if blank.
NEXT_PUBLIC_PRODUCT_C_URL=
